{
  "name": "xot-online",
  "version": "0.3.15",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-assets.mjs",
    "check:assets": "node scripts/sync-assets.mjs --check",
    "predev": "npm run check:assets",
    "predeploy": "npm run check:assets",
    "dev": "wrangler dev --config wrangler.toml",
    "deploy": "wrangler deploy --config wrangler.toml --keep-vars",
    "test": "npm run check:assets && node --test tests/*.test.mjs",
    "smoke": "node scripts/smoke-native.mjs",
    "smoke:eneyida": "node scripts/smoke-public-players.mjs eneyida",
    "smoke:kinovezha": "node scripts/smoke-public-players.mjs kinovezha",
    "smoke:uaserials": "node scripts/smoke-public-players.mjs uaserials",
    "smoke:features": "node scripts/smoke-features.mjs",
    "server:start": "node server/index.mjs",
    "smoke:backup": "node scripts/smoke-backup.mjs",
    "smoke:ufdub": "node scripts/smoke-ufdub.mjs",
    "smoke:sources": "node scripts/smoke-source-controls.mjs",
    "smoke:serialno": "node scripts/smoke-serialno.mjs",
    "smoke:watch": "node scripts/smoke-watch.mjs",
    "smoke:favorite-voices": "node scripts/smoke-favorite-voices.mjs",
    "smoke:watch-controls": "node scripts/smoke-watch-controls.mjs",
    "smoke:comfort": "node scripts/smoke-comfort.mjs",
    "smoke:player-comfort": "node scripts/smoke-player-comfort.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.61.1",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "htmlparser2": "^10.1.0"
  }
}
